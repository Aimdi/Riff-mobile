<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget (NowPlayingWidget.kt) in the app's Lights-out look:
     black, the art with the small corner radius, title and artist, then
     previous, play/pause on an accent circle, and next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/widget_padding"
    android:paddingTop="@dimen/widget_padding"
    android:paddingEnd="@dimen/widget_padding_end"
    android:paddingBottom="@dimen/widget_padding">

    <LinearLayout
        android:id="@+id/widget_info"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="@dimen/widget_art"
            android:layout_height="@dimen/widget_art"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_name"
                android:textColor="@color/widget_text"
                android:textSize="@dimen/widget_title_text" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="@dimen/widget_artist_text"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_previous"
        android:layout_width="@dimen/widget_button"
        android:layout_height="@dimen/widget_button"
        android:layout_marginStart="@dimen/widget_button_gap"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/widget_previous"
        android:scaleType="center"
        android:src="@drawable/ic_widget_previous" />

    <FrameLayout
        android:id="@+id/widget_play"
        android:layout_width="@dimen/widget_button"
        android:layout_height="@dimen/widget_button"
        android:layout_marginStart="@dimen/widget_button_gap"
        android:contentDescription="@string/widget_play">

        <ImageView
            android:id="@+id/widget_play_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_play_circle" />

        <ImageView
            android:id="@+id/widget_play_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_widget_play" />
    </FrameLayout>

    <ImageView
        android:id="@+id/widget_next"
        android:layout_width="@dimen/widget_button"
        android:layout_height="@dimen/widget_button"
        android:layout_marginStart="@dimen/widget_button_gap"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/widget_next"
        android:scaleType="center"
        android:src="@drawable/ic_widget_next" />
</LinearLayout>
